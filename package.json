{
  "name": "house-party",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "QR-join party platform: a TV page plus phone controllers.",
  "scripts": {
    "dev": "HP_MODE=dev tsx watch server/main.ts",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && vite build",
    "start": "HP_MODE=prod tsx server/main.ts",
    "test": "node scripts/test.mjs",
    "test:prod": "npm run build && HP_MODE=prod npm test",
    "bots": "tsx bots/run-browser.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "n8ao": "^2.0.0",
    "postprocessing": "^6.39.3",
    "qrcode": "^1.5.4",
    "simplex-noise": "^4.0.3",
    "socket.io": "^4.8.1",
    "three": "^0.185.1",
    "tsx": "^4.20.0",
    "vite": "^8.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/three": "^0.185.1",
    "playwright": "^1.63.0",
    "socket.io-client": "^4.8.1",
    "typescript": "^7.0.2"
  }
}
